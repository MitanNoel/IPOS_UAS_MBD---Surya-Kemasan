# Database Configuration
# For use with Coolify or Docker environment variables
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=db_toko_1
DB_USERNAME=toko_user
DB_PASSWORD=your_secure_password_here

# Alternative naming convention (both work)
# database.default.hostname=mysql
# database.default.port=3306
# database.default.database=db_toko_1
# database.default.username=toko_user
# database.default.password=your_secure_password_here

# Application Environment
APP_ENV=production
APP_DEBUG=false
